    "payment_amount": {
      "type": "MINOR_UNITS",
      "required": true
    },
    "return_count": {
      "type": "INTEGER",
      "required": true
    },
    "return_amount": {
      "type": "MINOR_UNITS",
      "required": true
    }
  }
}
